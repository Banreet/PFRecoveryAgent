# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required for the LLM agent (GPT-4o) and optional vector embeddings.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI embeddings deployment (used for vector search in Azure AI Search).
# Set to your text-embedding-3-small or ada-002 deployment name to enable vector search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Required to enable semantic + vector search over RCAs, TSGs, and dependencies.
# Leave blank to fall back to local keyword search.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_search_admin_key_here

# Index names (defaults shown – override if you use custom names)
AZURE_SEARCH_RCA_INDEX=pf-rcas
AZURE_SEARCH_TSG_INDEX=pf-tsgs
AZURE_SEARCH_DEPENDENCY_INDEX=pf-dependencies

# ── Standard OpenAI (fallback if Azure OpenAI is not configured) ──────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
