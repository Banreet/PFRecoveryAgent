# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Required for the LLM agent (GPT-4o) and optional vector embeddings.
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure OpenAI embeddings deployment (used for vector search in Azure AI Search).
# Set to your text-embedding-3-small or ada-002 deployment name to enable vector search.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ── Azure AI Search ───────────────────────────────────────────────────────────
# Required to enable semantic + vector search over RCAs, TSGs, and dependencies.
# Leave blank to fall back to local keyword search.
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_API_KEY=your_search_admin_key_here

# Index names (defaults shown – override if you use custom names)
AZURE_SEARCH_RCA_INDEX=pf-rcas
AZURE_SEARCH_TSG_INDEX=pf-tsgs
AZURE_SEARCH_DEPENDENCY_INDEX=pf-dependencies

# ── Azure Subscription & Identity ────────────────────────────────────────────
# Used by live data tools (Monitor, Resource Health, Service Health).
# DefaultAzureCredential supports: Managed Identity, Service Principal, Azure CLI.
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_TENANT_ID=your-tenant-id-here

# Service Principal credentials (only needed when NOT using Managed Identity or CLI)
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-client-secret

# ── Azure Monitor / Log Analytics ─────────────────────────────────────────────
# Required for live telemetry queries (errors, exceptions, failed dependencies).
# Find this in Azure Portal: Log Analytics workspace > Overview > Workspace ID
AZURE_LOG_ANALYTICS_WORKSPACE_ID=your-log-analytics-workspace-id

# Default time window (hours) for live log queries when none is specified
AZURE_MONITOR_DEFAULT_WINDOW_HOURS=2

# ── Azure Resource Group ──────────────────────────────────────────────────────
# Resource group containing PF Azure resources (AKS, CosmosDB, ServiceBus, etc.)
AZURE_RESOURCE_GROUP=pf-resource-group

# ── Standard OpenAI (fallback if Azure OpenAI is not configured) ──────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
